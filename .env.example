# Все ключи необязательные. Без них скилл работает на бесплатном стеке (этапы 1-2).
# Скопируй файл в .env и впиши нужные значения. .env в .gitignore, в git не попадёт.

# Apify: этапы 3-4 (профиль и посты ЛПР в LinkedIn, Instagram компании).
# Бесплатного плана ($5 в месяц) хватает на десятки компаний.
# Ключ: console.apify.com → Settings → Integrations
APIFY_API_KEY=

# goszakup.gov.kz: история госзакупок компании. Токен бесплатный, выдаётся по заявке.
GOSZAKUP_TOKEN=

# Scrape.do: обход блокировок сайтов, платный.
SCRAPEDO_TOKEN=

# Yandex Search API: поиск по русскоязычным источникам, платный.
YANDEX_SEARCH_API_KEY=
